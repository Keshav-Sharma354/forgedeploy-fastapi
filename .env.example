# ==============================================================================
# FastAPI Production Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and populate it with actual production values.
# NEVER commit the active '.env' file containing real secrets to version control.

# --- General App Settings ---
PROJECT_NAME="ForgeDeploy API"
ENVIRONMENT=production   # Choices: development, staging, production
DEBUG=false
SECRET_KEY=replace-with-a-secure-random-64-character-string
JWT_SECRET=replace-with-another-secure-random-64-character-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database (PostgreSQL) Settings ---
# Note: For Docker Compose, the host must match the service name 'postgres'
POSTGRES_USER=appuser
POSTGRES_PASSWORD=generate-a-strong-password-with-at-least-24-characters
POSTGRES_DB=appdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://appuser:generate-a-strong-password-with-at-least-24-characters@postgres:5432/appdb

# --- Cache & Broker (Redis) Settings ---
# Note: For Docker Compose, the host must match the service name 'redis'
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# --- Network & SSL Deployment Settings ---
DOMAIN=example.com
SSL_EMAIL=admin@example.com
USE_SSL=true             # Set to true in production. Set to false to test local NGINX HTTP.
NGINX_PORT=80
NGINX_SSL_PORT=443
